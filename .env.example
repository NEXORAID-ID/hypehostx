# Copy to .env and replace the placeholder with a private local-only password.
# Keep actual values in .env; never put them in Git or dist/web.
POSTGRES_PASSWORD=replace-with-a-private-local-password
DATABASE_URL=postgres://hypehostx:replace-with-a-private-local-password@127.0.0.1:5432/hypenet
# Comma-separated exact browser origins; do not use a wildcard.
ALLOWED_ORIGINS=http://127.0.0.1:3000

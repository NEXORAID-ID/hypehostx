{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nexoraid-id.github.io/hypehostx/schemas/compatibility-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revision": { "type": "string", "pattern": "^r[0-9]+$" },
    "records": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["firmware", "status", "evidenceIds"],
        "properties": {
          "firmware": { "type": "string", "pattern": "^(?:[1-9]|[1-9][0-9])\\.[0-9]{2}$" },
          "status": {
            "enum": [
              "reference_listed",
              "under_review",
              "verified",
              "failed",
              "withdrawn",
              "unsupported"
            ]
          },
          "evidenceIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 128 }
          },
          "reviewer": { "type": "string", "minLength": 1, "maxLength": 128 },
          "reviewedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
        },
        "if": { "properties": { "status": { "const": "verified" } } },
        "then": {
          "required": ["reviewer", "reviewedAt"],
          "properties": { "evidenceIds": { "type": "array", "minItems": 1 } }
        }
      }
    }
  }
}

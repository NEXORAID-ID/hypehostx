{
  "name": "hypehostx",
  "version": "0.1.0-dev",
  "private": true,
  "description": "Original HYPEHOSTX information host \u2014 MR.4NONY / NEXORAID",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "node tools/build.cjs",
    "validate": "node tools/validate.cjs",
    "lint": "node tools/validate.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:unit": "node --test tests/*.test.cjs",
    "test:legacy": "node tools/validate.cjs",
    "dev": "node tools/serve.cjs",
    "verify:dist": "node tools/verify.cjs",
    "test:browser": "node tests/browser.cjs",
    "test:browser:webkit": "node tests/browser.cjs webkit",
    "test:web-negative": "node tests/web-negative.cjs",
    "test:web-negative:webkit": "node tests/web-negative.cjs webkit",
    "dev:network": "tsx backend/dev/local.ts",
    "build:backend": "tsc -p backend/tsconfig.json",
    "start:backend": "node --env-file=.env artifacts/backend/main.js",
    "test:network": "tsx --test backend/tests/*.ts",
    "test:native": "node tools/native.cjs",
    "test:native:asan": "node tools/native.cjs --asan",
    "test:a11y": "node tests/accessibility.cjs",
    "test:online-browser": "node tests/online-browser.cjs",
    "contracts": "node tools/contracts.cjs",
    "audit:local": "node tools/audit.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "acorn": "8.19.0",
    "ajv": "8.20.0",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@fastify/websocket": "11.3.7",
    "fastify": "5.12.8",
    "pg": "8.23.1"
  }
}
